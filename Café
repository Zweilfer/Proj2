struct InputEnded {};

static string ask(const string& prompt) {
    cout << prompt << flush;
    string line;
    if (!getline(cin, line)) throw InputEnded{};
    if (!line.empty() && line.back() == '\r') line.pop_back();
    return line;
}

static bool askInt(const string& prompt, int& out, bool allowBlank = false) {
    while (true) {
        string s = trim(ask(prompt));
        if (allowBlank && s.empty()) return false;
        try {
            size_t used = 0;
            int v = stoi(s, &used);
            if (used == s.size()) { out = v; return true; }
        } catch (const exception&) {}
        cout << "  [!] Please enter a whole number.\n";
    }
}

static void run() {
    CafeSystem sys;
    CafeTree& tree = sys.tree;
    CustomerQueue& queue = sys.queue;
    cout << "Welcome to the Cafe Queue and Table Zone Management System\n";
    try {
        while (true) {
            cout << MENU;
            string choice = trim(ask("Choose a menu option: "));
            try {
                if (choice == "0") {
                    cout << "Goodbye!\n";
                    break;
                } else if (choice == "1") {
                    string name = trim(ask("Cafe name (blank = My Cafe): "));
                    if (name.empty()) name = "My Cafe";
                    tree.create(name);
                    cout << "  [OK] Created cafe '" << name << "' with zones Indoor and Outdoor\n";
                    tree.render();
                } else if (choice == "2") {
                    TreeNode* z = tree.insertZone(ask("New zone name: "));
                    cout << "  [OK] Added zone " << z->name << "\n";
                } else if (choice == "3") {
                    string zone = ask("Zone name: ");
                    string tid = ask("Table id: ");
                    int seats = 0;
                    askInt("Number of seats: ", seats);
                    TreeNode* t = tree.insertTable(zone, tid, seats);
                    cout << "  [OK] Added table " << t->name << " (" << t->seats
                         << " seats) to zone " << t->parent->name << "\n";
                } else if (choice == "4") {
                    TreeNode* n = tree.find(ask("Zone name or table id: "));
                    if (!n) cout << "  [X] Not found\n";
                    else {
                        cout << "  [OK] Found: " << n->label() << "\n";
                        if (n->parent) cout << "    located under: " << n->parent->label() << "\n";
                    }
                } else if (choice == "5") {
                    int seats = 1;
                    if (!askInt("Minimum seats (blank = any): ", seats, true)) seats = 1;
                    string zone = trim(ask("Zone (blank = all zones): "));
                    ResultList res = tree.searchAvailable(seats, zone);
                    if (res.size == 0) cout << "  [X] No available tables match\n";
                    else {
                        cout << "  Available tables (" << res.size << "):\n";
                        for (ResultNode* r = res.head; r; r = r->next)
                            cout << "   - " << r->data->label() << " in zone " << r->data->parent->name << "\n";
                    }
                } else if (choice == "6") {
                    string name = tree.deleteZone(ask("Zone name to delete: "));
                    cout << "  [OK] Deleted zone " << name << " and all its tables\n";
                } else if (choice == "7") {
                    string name = tree.deleteTable(ask("Table id to delete: "));
                    cout << "  [OK] Deleted table " << name << "\n";
                } else if (choice == "8") {
                    tree.render();
                } else if (choice == "9") {
                    queue.create();
                    cout << "  [OK] Created an empty queue\n";
                } else if (choice == "10" || choice == "11") {
                    string name = ask("Customer name: ");
                    int n = 0;
                    askInt("Party size: ", n);
                    QueueNode* node = queue.enqueue(name, n, choice == "11");
                    int pos = queue.search(node->code, nullptr);
                    cout << "  [OK] Queued: " << node->info() << "  (position " << pos << ")\n";
                } else if (choice == "12") {
                    QueueNode* node = nullptr;
                    int pos = queue.search(ask("Queue code (e.g. Q001): "), &node);
                    if (!node) cout << "  [X] Queue code not found\n";
                    else {
                        cout << "  [OK] Position " << pos << " of " << queue.getSize() << ": " << node->info() << "\n";
                        cout << "    people ahead: " << pos - 1 << "\n";
                    }
                } else if (choice == "13") {
                    QueueNode n = queue.dequeue();
                    cout << "  [OK] Removed head of queue: " << n.info() << "\n";
                } else if (choice == "14") {
                    QueueNode n = queue.remove(ask("Queue code to cancel: "));
                    cout << "  [OK] Cancelled: " << n.info() << "\n";
                } else if (choice == "15") {
                    cout << "  Waiting queue (" << queue.getSize() << "):\n";
                    queue.render();
                } else if (choice == "16") {
                    sys.callNext();
                } else if (choice == "17") {
                    sys.freeTable(ask("Table id to free: "));
                } else if (choice == "18") {
                    sys.loadSample();
                    cout << "  [OK] Sample data loaded\n";
                    tree.render();
                    queue.render();
                } else {
                    cout << "  [!] Invalid option. Please choose 0-18.\n";
                }
            } catch (const runtime_error& e) {
                cout << "  [X] " << e.what() << "\n";
            }
        }
    } catch (const InputEnded&) {
        cout << "\n(input ended) Goodbye!\n";
    }
}

int main() {
    run();
    return 0;
}
