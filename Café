using namespace std;


static string trim(const string& s) {
    size_t a = 0, b = s.size();
    while (a < b && isspace((unsigned char)s[a])) a++;
    while (b > a && isspace((unsigned char)s[b - 1])) b--;
    return s.substr(a, b - a);
}

static string toLower(string s) {
    for (char& c : s) c = (char)tolower((unsigned char)c);
    return s;
}

static string toUpper(string s) {
    for (char& c : s) c = (char)toupper((unsigned char)c);
    return s;
}

static bool equalsIgnoreCase(const string& a, const string& b) {
    return toLower(a) == toLower(b);
}

enum class NodeKind { CAFE, ZONE, TABLE };

struct TreeNode {
    string name;
    NodeKind kind;
    int seats;               
    bool occupied;           
    string customer;         
    TreeNode* parent;
    TreeNode* firstChild;    
    TreeNode* nextSibling;   

    TreeNode(const string& n, NodeKind k, int s = 0)
        : name(n), kind(k), seats(s), occupied(false), customer(""),
          parent(nullptr), firstChild(nullptr), nextSibling(nullptr) {}

    void addChild(TreeNode* child) {
        child->parent = this;
        child->nextSibling = nullptr;
        if (!firstChild) { firstChild = child; return; }
        TreeNode* cur = firstChild;
        while (cur->nextSibling) cur = cur->nextSibling;
        cur->nextSibling = child;
    }

    bool removeChild(TreeNode* child) {
        TreeNode* prev = nullptr;
        TreeNode* cur = firstChild;
        while (cur) {
            if (cur == child) {
                if (!prev) firstChild = cur->nextSibling;
                else prev->nextSibling = cur->nextSibling;
                cur->parent = nullptr;
                cur->nextSibling = nullptr;
                return true;
            }
            prev = cur;
            cur = cur->nextSibling;
        }
        return false;
    }

    string label() const {
        if (kind == NodeKind::TABLE) {
            string s = "Table " + name + " [" + to_string(seats) + " seats, " +
                       (occupied ? "occupied" : "available") + "]";
            if (!customer.empty()) s += " (customer " + customer + ")";
            return s;
        }
        if (kind == NodeKind::ZONE) return "Zone " + name;
        return "Cafe " + name;
    }
};

static void freeSubtree(TreeNode* node) {
    if (!node) return;
    TreeNode* child = node->firstChild;
    while (child) {
        TreeNode* next = child->nextSibling;
        freeSubtree(child);
        child = next;
    }
    delete node;
}

struct StackNode {
    TreeNode* data;
    StackNode* next;
};

class NodeStack {
    StackNode* top = nullptr;
public:
    ~NodeStack() { while (!isEmpty()) pop(); }
    void push(TreeNode* x) { top = new StackNode{x, top}; }
    TreeNode* pop() {
        StackNode* n = top;
        TreeNode* d = n->data;
        top = n->next;
        delete n;
        return d;
    }
    bool isEmpty() const { return top == nullptr; }
};

struct ResultNode {
    TreeNode* data;
    ResultNode* next;
};

class ResultList {
public:
    ResultNode* head = nullptr;
    ResultNode* tail = nullptr;
    int size = 0;
    ResultList() = default;
    ResultList(const ResultList&) = delete;
    ResultList& operator=(const ResultList&) = delete;
    ResultList(ResultList&& o) noexcept : head(o.head), tail(o.tail), size(o.size) {
        o.head = o.tail = nullptr; o.size = 0;
    }
    ~ResultList() {
        while (head) { ResultNode* n = head->next; delete head; head = n; }
    }
    void append(TreeNode* x) {
        ResultNode* n = new ResultNode{x, nullptr};
        if (!head) head = tail = n;
        else { tail->next = n; tail = n; }
        size++;
    }
};

class CafeTree {
    TreeNode* root = nullptr;

    void requireRoot() const {
        if (!root) throw runtime_error("Tree has not been created yet. Please create it first.");
    }

    template <typename F>
    void dfs(TreeNode* start, F visit) const {
        NodeStack stack;
        if (start) stack.push(start);
        while (!stack.isEmpty()) {
            TreeNode* cur = stack.pop();
            visit(cur);
            NodeStack rev;
            for (TreeNode* c = cur->firstChild; c; c = c->nextSibling) rev.push(c);
            while (!rev.isEmpty()) stack.push(rev.pop());
        }
    }

    void renderRec(TreeNode* node, const string& prefix) const {
        for (TreeNode* cur = node->firstChild; cur; cur = cur->nextSibling) {
            bool last = (cur->nextSibling == nullptr);
            cout << prefix << (last ? "`-- " : "|-- ") << cur->label() << "\n";
            renderRec(cur, prefix + (last ? "    " : "|   "));
        }
    }

public:
    CafeTree() = default;
    CafeTree(const CafeTree&) = delete;
    CafeTree& operator=(const CafeTree&) = delete;
    ~CafeTree() { freeSubtree(root); }

    TreeNode* getRoot() const { return root; }

    void create(const string& cafeName) {
        freeSubtree(root);
        root = new TreeNode(cafeName, NodeKind::CAFE);
        root->addChild(new TreeNode("Indoor", NodeKind::ZONE));
        root->addChild(new TreeNode("Outdoor", NodeKind::ZONE));
    }

    TreeNode* find(const string& name, int kindFilter = -1) const {
        requireRoot();
        string key = trim(name);
        TreeNode* found = nullptr;
        dfs(root, [&](TreeNode* n) {
            if (!found && equalsIgnoreCase(n->name, key) &&
                (kindFilter == -1 || (int)n->kind == kindFilter))
                found = n;
        });
        return found;
    }

    ResultList searchAvailable(int minSeats, const string& zone = "") const {
        requireRoot();
        TreeNode* start = root;
        if (!zone.empty()) {
            start = find(zone, (int)NodeKind::ZONE);
            if (!start) throw runtime_error("Zone '" + zone + "' not found.");
        }
        ResultList result;
        dfs(start, [&](TreeNode* n) {
            if (n->kind == NodeKind::TABLE && !n->occupied && n->seats >= minSeats)
                result.append(n);
        });
        return result;
    }

    TreeNode* bestTableFor(int partySize) const {
        ResultList list = searchAvailable(partySize);
        TreeNode* best = nullptr;
        for (ResultNode* r = list.head; r; r = r->next)
            if (!best || r->data->seats < best->seats) best = r->data;
        return best;
    }

    TreeNode* insertZone(const string& zoneName) {
        requireRoot();
        string z = trim(zoneName);
        if (z.empty()) throw runtime_error("Zone name must not be empty.");
        if (find(z, (int)NodeKind::ZONE)) throw runtime_error("Zone '" + z + "' already exists.");
        TreeNode* node = new TreeNode(z, NodeKind::ZONE);
        root->addChild(node);
        return node;
    }

    TreeNode* insertTable(const string& zoneName, const string& tableId, int seats) {
        requireRoot();
        TreeNode* zone = find(zoneName, (int)NodeKind::ZONE);
        if (!zone) throw runtime_error("Zone '" + trim(zoneName) + "' not found.");
        string id = trim(tableId);
        if (id.empty()) throw runtime_error("Table id must not be empty.");
        if (find(id, (int)NodeKind::TABLE)) throw runtime_error("Table '" + id + "' already exists.");
        if (seats <= 0) throw runtime_error("Seats must be greater than 0.");
        TreeNode* node = new TreeNode(id, NodeKind::TABLE, seats);
        zone->addChild(node);
        return node;
    }


    string deleteZone(const string& zoneName) {
        requireRoot();
        TreeNode* zone = find(zoneName, (int)NodeKind::ZONE);
        if (!zone) throw runtime_error("Zone '" + trim(zoneName) + "' not found.");
        for (TreeNode* t = zone->firstChild; t; t = t->nextSibling)
            if (t->occupied)
                throw runtime_error("Zone '" + zone->name + "' still has occupied table " + t->name + ".");
        string name = zone->name;
        root->removeChild(zone);
        freeSubtree(zone);              
        return name;
    }

    string deleteTable(const string& tableId) {
        requireRoot();
        TreeNode* table = find(tableId, (int)NodeKind::TABLE);
        if (!table) throw runtime_error("Table '" + trim(tableId) + "' not found.");
        if (table->occupied) throw runtime_error("Table '" + table->name + "' is occupied. Free it first.");
        string name = table->name;
        table->parent->removeChild(table);
        delete table;
        return name;
    }

    void render() const {
        if (!root) { cout << "(tree not created yet)\n"; return; }
        cout << root->label() << "\n";
        renderRec(root, "");
    }
};



struct QueueNode {
    string code;        
    string name;
    int partySize;
    bool priority;      
    QueueNode* next;

    QueueNode(const string& c, const string& n, int p, bool pr)
        : code(c), name(n), partySize(p), priority(pr), next(nullptr) {}

    string info() const {
        return code + " | " + name + " | " + to_string(partySize) + " people" +
               (priority ? " [PRIORITY]" : "");
    }
};

class CustomerQueue {
    QueueNode* head = nullptr;
    QueueNode* tail = nullptr;
    int size = 0;
    int counter = 0;

    void clear() {
        while (head) { QueueNode* n = head->next; delete head; head = n; }
        tail = nullptr;
        size = 0;
    }

    string nextCode() {
        char buf[16];
        snprintf(buf, sizeof(buf), "Q%03d", ++counter);
        return string(buf);
    }

public:
    CustomerQueue() { create(); }
    CustomerQueue(const CustomerQueue&) = delete;
    CustomerQueue& operator=(const CustomerQueue&) = delete;
    ~CustomerQueue() { clear(); }

    void create() { clear(); counter = 0; }

    bool isEmpty() const { return head == nullptr; }
    int getSize() const { return size; }
    QueueNode* peek() const { return head; }

    QueueNode* enqueue(const string& rawName, int partySize, bool priority) {
        string name = trim(rawName);
        if (name.empty()) throw runtime_error("Customer name must not be empty.");
        if (partySize <= 0) throw runtime_error("Party size must be greater than 0.");
        QueueNode* node = new QueueNode(nextCode(), name, partySize, priority);

        if (!priority || !head) {
            if (!head) head = tail = node;
            else { tail->next = node; tail = node; }
        } else if (!head->priority) {
            node->next = head;          
            head = node;
        } else {
            QueueNode* cur = head;      
            while (cur->next && cur->next->priority) cur = cur->next;
            node->next = cur->next;
            cur->next = node;
            if (!node->next) tail = node;
        }
        size++;
        return node;
    }

    int search(const string& rawCode, QueueNode** outNode) const {
        string code = toUpper(trim(rawCode));
        int pos = 1;
        for (QueueNode* cur = head; cur; cur = cur->next, pos++) {
            if (cur->code == code) { if (outNode) *outNode = cur; return pos; }
        }
        if (outNode) *outNode = nullptr;
        return 0;
    }

    QueueNode dequeue() {
        if (!head) throw runtime_error("The queue is empty.");
        QueueNode* n = head;
        head = n->next;
        if (!head) tail = nullptr;
        QueueNode copy = *n;
        copy.next = nullptr;
        delete n;
        size--;
        return copy;
    }

    QueueNode remove(const string& rawCode) {
        string code = toUpper(trim(rawCode));
        QueueNode* prev = nullptr;
        for (QueueNode* cur = head; cur; prev = cur, cur = cur->next) {
            if (cur->code == code) {
                if (!prev) head = cur->next;
                else prev->next = cur->next;
                if (cur == tail) tail = prev;
                QueueNode copy = *cur;
                copy.next = nullptr;
                delete cur;
                size--;
                return copy;
            }
        }
        throw runtime_error("Queue code '" + code + "' not found.");
    }

    void render() const {
        if (!head) { cout << "(queue is empty)\n"; return; }
        int pos = 1;
        for (QueueNode* cur = head; cur; cur = cur->next, pos++)
            cout << "  " << pos << ". " << cur->info() << "\n";
        cout << "  HEAD -> ";
        for (QueueNode* cur = head; cur; cur = cur->next) cout << cur->code << " -> ";
        cout << "NULL\n";
    }
};


class CafeSystem {
public:
    CafeTree tree;
    CustomerQueue queue;

    void callNext() {
        QueueNode* head = queue.peek();
        if (!head) throw runtime_error("No customers waiting.");
        TreeNode* table = tree.bestTableFor(head->partySize);
        if (!table)
            throw runtime_error("No available table for " + to_string(head->partySize) +
                                " people (" + head->code + "). Customer keeps waiting.");
        QueueNode c = queue.dequeue();
        table->occupied = true;
        table->customer = c.code;
        cout << "  [CALL] Calling " << c.code << " - " << c.name << " (" << c.partySize << " people)\n";
        cout << "  [OK] Please go to table " << table->name << ", zone " << table->parent->name
             << " (" << table->seats << " seats)\n";
    }

    void freeTable(const string& tableId) {
        TreeNode* t = tree.find(tableId, (int)NodeKind::TABLE);
        if (!t) throw runtime_error("Table '" + trim(tableId) + "' not found.");
        if (!t->occupied) throw runtime_error("Table '" + t->name + "' is already available.");
        t->occupied = false;
        t->customer = "";
        cout << "  [OK] Table " << t->name << " is available again\n";
    }

    void loadSample() {
        tree.create("Lily Cafe");
        tree.insertTable("Indoor", "A1", 2);
        tree.insertTable("Indoor", "A2", 4);
        tree.insertTable("Indoor", "A3", 6);
        tree.insertTable("Outdoor", "B1", 2);
        tree.insertTable("Outdoor", "B2", 4);
        queue.create();
        queue.enqueue("Kiwi", 2, false);
        queue.enqueue("Khaowmai", 4, false);
        queue.enqueue("Kavin", 3, true);
        queue.enqueue("Knight", 5, false);
    }
};

